 ESP_DIR="::/EFI/aarambh"
 CONFIG="$WORK_DIR/aarambh.conf"
-THEMES="accordion minimal glass-sidebar editorial editorial-dark cinema honeycomb constellation picker-wheel dial hud departures gallery"
+THEMES="accordion minimal glass-sidebar editorial editorial-dark editorial-gruvbox cinema honeycomb constellation picker-wheel dial hud departures gallery"
 
 export MTOOLS_SKIP_CHECK=1
 
