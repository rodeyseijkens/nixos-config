+
 #endif
diff --git a/src/core/config.c b/src/core/config.c
index fb513da..abc8e52 100644
--- a/src/core/config.c
+++ b/src/core/config.c
@@ -37,12 +37,16 @@ static char *split_key_value(char *line)
     return str_trim(value);
 }
 
+static void add_schedule(Config *config, const char *value);
+
 static void apply_setting(Config *config, EntryList *entries, const char *key, char *value)
 {
     if (str_equal(key, "timeout")) {
         str_parse_count(value, CONFIG_TIMEOUT_MAX, &config->timeout_seconds);
     } else if (str_equal(key, "default")) {
         str_copy(config->default_entry, value, sizeof(config->default_entry));
+    } else if (str_equal(key, "schedule")) {
+        add_schedule(config, value);
     } else if (str_equal(key, "utc_offset")) {
         config->utc_offset_minutes = clock_parse_offset(value);
     } else if (str_equal(key, "autodetect")) {
@@ -102,6 +106,273 @@ static int find_default(const EntryList *entries, const char *name)
     return 0;
 }
 
+
+static const char *day_names[] = {
+    "mon", "tue", "wed", "thu", "fri", "sat", "sun"
+};
+
+/* Monday = 0 .. Sunday = 6 from a three-letter name, -1 when unknown. */
+static int parse_weekday(const char *text, int length)
+{
+    int day;
+
+    if (length != 3) {
+        return -1;
+    }
+
+    for (day = 0; day < 7; day++) {
+        if (str_starts_with_nocase(text, day_names[day])) {
+            return day;
+        }
+    }
+
+    return -1;
+}
+
+/* One day or one inclusive range, e.g. "mon" or "mon-fri". */
+static int parse_day_part(const char *text, unsigned *days)
+{
+    const char *dash = text;
+    int from;
+    int to;
+    int day;
+    int length = (int)str_length(text);
+
+    while (dash[0] != '\0' && dash[0] != '-') {
+        dash++;
+    }
+
+    from = parse_weekday(text, (int)(dash - text));
+    if (from < 0) {
+        return 0;
+    }
+
+    to = from;
+    if (dash[0] == '-') {
+        to = parse_weekday(dash + 1, length - (int)(dash - text) - 1);
+        if (to < 0) {
+            return 0;
+        }
+    }
+
+    for (day = from;; day = (day + 1) % 7) {
+        *days |= 1u << day;
+        if (day == to) {
+            break;
+        }
+    }
+
+    return 1;
+}
+
+/* "*", or comma separated names and ranges: "mon-fri", "sat,sun". */
+static int parse_days(const char *text, unsigned *days)
+{
+    char buffer[64];
+    char *cursor;
+
+    *days = 0;
+    if (str_equal(text, "*")) {
+        *days = 0x7fu;
+        return 1;
+    }
+
+    if (str_length(text) >= sizeof(buffer)) {
+        return 0;
+    }
+
+    str_copy(buffer, text, sizeof(buffer));
+    cursor = buffer;
+    while (*cursor != '\0') {
+        char *separator = cursor;
+        int more = 0;
+        int ok;
+
+        while (*separator != '\0' && *separator != ',') {
+            separator++;
+        }
+        if (*separator == ',') {
+            *separator = '\0';
+            more = 1;
+        }
+
+        ok = parse_day_part(str_trim(cursor), days);
+        if (!ok) {
+            return 0;
+        }
+        if (!more) {
+            break;
+        }
+        cursor = separator + 1;
+    }
+
+    return *days != 0;
+}
+
+/* "HH:MM" in 24-hour local time, or -1. */
+static int parse_clock_minutes(const char *text)
+{
+    int hour;
+    int minute;
+
+    if (str_length(text) != 5 || text[2] != ':') {
+        return -1;
+    }
+    if (text[0] < '0' || text[0] > '9' || text[1] < '0' || text[1] > '9'
+        || text[3] < '0' || text[3] > '9' || text[4] < '0' || text[4] > '9') {
+        return -1;
+    }
+
+    hour = (text[0] - '0') * 10 + (text[1] - '0');
+    minute = (text[3] - '0') * 10 + (text[4] - '0');
+    if (hour > 23 || minute > 59) {
+        return -1;
+    }
+
+    return hour * 60 + minute;
+}
+
+/*
+ * "schedule <entry> <days> <start>-<end>": the entry key, the days, and a
+ * local window whose end is exclusive. Anything malformed is ignored.
+ */
+static void add_schedule(Config *config, const char *value)
+{
+    char buffer[CONFIG_DEFAULT_MAX + 64];
+    char *cursor;
+    char *entry;
+    char *days;
+    char *window;
+    char *dash;
+    Schedule *schedule;
+
+    if (config->schedule_count >= CONFIG_MAX_SCHEDULES) {
+        return;
+    }
+    if (str_length(value) >= sizeof(buffer)) {
+        return;
+    }
+
+    str_copy(buffer, value, sizeof(buffer));
+    cursor = buffer;
+
+    entry = cursor;
+    while (*cursor != '\0' && *cursor != ' ' && *cursor != '\t') {
+        cursor++;
+    }
+    if (*cursor == '\0') {
+        return;
+    }
+    *cursor++ = '\0';
+
+    days = str_trim(cursor);
+    cursor = days;
+    while (*cursor != '\0' && *cursor != ' ' && *cursor != '\t') {
+        cursor++;
+    }
+    if (*cursor == '\0') {
+        return;
+    }
+    *cursor++ = '\0';
+    window = str_trim(cursor);
+
+    dash = window;
+    while (dash[0] != '\0' && dash[0] != '-') {
+        dash++;
+    }
+    if (dash[0] != '-') {
+        return;
+    }
+    *dash = '\0';
+
+    schedule = &config->schedules[config->schedule_count];
+    mem_set(schedule, 0, sizeof(*schedule));
+    str_copy(schedule->entry, entry, sizeof(schedule->entry));
+
+    if (!parse_days(days, &schedule->days)) {
+        return;
+    }
+
+    schedule->start_minutes = parse_clock_minutes(window);
+    schedule->end_minutes = parse_clock_minutes(dash + 1);
+    if (schedule->start_minutes < 0 || schedule->end_minutes < 0
+        || schedule->start_minutes >= schedule->end_minutes) {
+        return;
+    }
+
+    config->schedule_count++;
+}
+
+/* Sakamoto: 0 = Sunday .. 6 = Saturday for a date. */
+static int weekday_from_date(int year, int month, int day)
+{
+    static const int offsets[] = { 0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4 };
+
+    if (month < 3) {
+        year -= 1;
+    }
+
+    return (year + year / 4 - year / 100 + year / 400 + offsets[month - 1] + day) % 7;
+}
+
+/* The Monday-based weekday and minute of day, shifted by the local offset. */
+static void local_clock(const EFI_TIME *time, int offset, int *weekday, int *minutes)
+{
+    int day;
+    int total;
+
+    *minutes = clock_local_minutes(time, offset);
+    *weekday = (weekday_from_date(time->Year, time->Month, time->Day) + 6) % 7;
+
+    /* The offset can move the minute of day across midnight, and the day too. */
+    total = time->Hour * 60 + time->Minute + offset;
+    day = total / 1440;
+    if (total < 0) {
+        day = -1;
+    }
+    *weekday = ((*weekday + day) % 7 + 7) % 7;
+}
+
+static int schedule_matches(const Schedule *schedule, int weekday, int minutes)
+{
+    return (schedule->days & (1u << weekday)) != 0
+        && minutes >= schedule->start_minutes && minutes < schedule->end_minutes;
+}
+
+/*
+ * A matching schedule picks the default entry; the last matching line wins so
+ * later rules can narrow earlier ones. Without a usable clock, nothing
+ * changes and the plain "default" applies.
+ */
+static void apply_schedules(Config *config, EntryList *entries)
+{
+    EFI_TIME time;
+    int weekday;
+    int minutes;
+    int i;
+
+    if (config->schedule_count == 0 || RT == NULL || RT->GetTime == NULL) {
+        return;
+    }
+    if (RT->GetTime(&time, NULL) != EFI_SUCCESS) {
+        return;
+    }
+
+    local_clock(&time, config->utc_offset_minutes, &weekday, &minutes);
+
+    for (i = 0; i < config->schedule_count; i++) {
+        int index;
+
+        if (!schedule_matches(&config->schedules[i], weekday, minutes)) {
+            continue;
+        }
+        index = find_default(entries, config->schedules[i].entry);
+        if (index >= 0) {
+            config->default_index = index;
+        }
+    }
+}
+
 static void parse_config(Config *config, EntryList *entries, char *text)
 {
     char *cursor = text;
@@ -141,4 +412,5 @@ void config_load(Config *config, EntryList *entries)
     entries_move_actions_last(entries);
 
     config->default_index = find_default(entries, config->default_entry);
+    apply_schedules(config, entries);
 }
\ No newline at end of file
diff --git a/src/core/config.h b/src/core/config.h
index 296e726..dc35d50 100644
--- a/src/core/config.h
+++ b/src/core/config.h
@@ -10,6 +10,21 @@
 /* The longest countdown; a larger value in aarambh.conf counts as this. */
 #define CONFIG_TIMEOUT_MAX 999
 
+/* How many "schedule" lines aarambh.conf may carry. */
+#define CONFIG_MAX_SCHEDULES 4
+
+/*
+ * One "schedule <entry> <days> <start>-<end>" line: while the local clock is
+ * in the window on one of the days, entry becomes the default selection.
+ * Days are bits 0..6 for Monday..Sunday; the end is exclusive.
+ */
+typedef struct {
+    char entry[CONFIG_DEFAULT_MAX];
+    unsigned days;
+    int start_minutes;
+    int end_minutes;
+} Schedule;
+
 typedef struct {
     int timeout_seconds;
     int default_index;
@@ -24,6 +39,8 @@ typedef struct {
     char font_bold[CONFIG_NAME_MAX];
     char font_mono[CONFIG_NAME_MAX];
     EntryVolumes volumes;
+    Schedule schedules[CONFIG_MAX_SCHEDULES];
+    int schedule_count;
 } Config;
 
 void config_load(Config *config, EntryList *entries);
