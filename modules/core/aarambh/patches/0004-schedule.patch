diff --git a/tests/unit/schedule_test.c b/tests/unit/schedule_test.c
new file mode 100644
index 0000000..6a7f80e
--- /dev/null
+++ b/tests/unit/schedule_test.c
@@ -0,0 +1,211 @@
+/*
+ * The "schedule" line: which default aarambh.conf picks from the local clock.
+ * Days are matched Monday-first, the window is minutes since midnight with an
+ * exclusive end, and the UEFI clock is read through RT->GetTime.
+ */
+
+#include <string.h>
+
+#include "core/clock.h"
+#include "core/config.h"
+#include "core/entries.h"
+#include "efi/fs.h"
+#include "lib/memory.h"
+#include "support/efi_mock.h"
+#include "support/test.h"
+
+static const char *config_text;
+
+void *fs_read(const char *name, UINTN *size)
+{
+    char *copy = mem_alloc(strlen(config_text) + 1);
+
+    strcpy(copy, config_text);
+    return copy;
+}
+
+/* Every loader exists: these tests are about the schedule, not the ESP. */
+void fs_make_path(CHAR16 *output, int capacity, const char *name)
+{
+    int i = 0;
+
+    while (name[i] != '\0' && i < capacity - 1) {
+        output[i] = (CHAR16)(UINT8)name[i];
+        i++;
+    }
+    output[i] = 0;
+}
+
+int fs_exists(const CHAR16 *path) { return 1; }
+int fs_exists_volume(const char *volume, const CHAR16 *path) { return 1; }
+int fs_volume_exists(int index, const CHAR16 *path) { return 1; }
+void fs_volume_list_directory(int index, const CHAR16 *path, FsDirectoryCallback callback,
+                              void *context) {}
+int fs_volumes_scan(void) { return 0; }
+const char *fs_volume_id(int index) { return ""; }
+int fs_volume_is_own(int index) { return 0; }
+
+void kernels_load(Entry *entry) {}
+int power_firmware_setup_supported(void) { return 1; }
+
+static const char *base_config =
+    "timeout 5\n"
+    "default nixos\n"
+    "schedule nixos-work mon-fri 07:00-18:00\n"
+    "volume work partuuid=4a512320-ad94-44b6-883f-ba9c8a3335c2\n"
+    "entry NixOS | \\EFI\\systemd\\systemd-bootx64.efi | logos/nixos.png | backgrounds/nixos.jpg | nixos\n"
+    "entry NixOS (work) | @work:\\EFI\\systemd\\systemd-bootx64.efi | logos/nixos.png | backgrounds/nixos.jpg | nixos-work\n";
+
+static int load_with_time(int year, int month, int day, int hour, int minute, int offset)
+{
+    static char config_buffer[1024];
+    Config config;
+    EntryList entries;
+
+    /* The offset lives in the config, like the installer writes it. */
+    if (offset == 0) {
+        snprintf(config_buffer, sizeof(config_buffer), "%s", base_config);
+    } else {
+        int sign = offset < 0 ? '-' : '+';
+        int absolute = offset < 0 ? -offset : offset;
+
+        snprintf(config_buffer, sizeof(config_buffer), "utc_offset %c%02d%02d\n%s", sign,
+                 absolute / 60, absolute % 60, base_config);
+    }
+    config_text = config_buffer;
+    mem_set(&entries, 0, sizeof(entries));
+
+    mock_set_time(year, month, day, hour, minute, offset);
+
+    config_load(&config, &entries);
+    return config.default_index;
+}
+
+static void test_weekday_morning_picks_work(void)
+{
+    /* 2026-11-16 is a Monday. */
+    CHECK(load_with_time(2026, 11, 16, 10, 0, 0) == 1, "monday 10:00 defaults to the work entry");
+}
+
+static void test_before_seven_picks_nixos(void)
+{
+    CHECK(load_with_time(2026, 11, 16, 6, 59, 0) == 0, "monday 06:59 stays on the plain default");
+}
+
+static void test_start_is_inclusive(void)
+{
+    CHECK(load_with_time(2026, 11, 16, 7, 0, 0) == 1, "monday 07:00 counts as work");
+}
+
+static void test_end_is_exclusive(void)
+{
+    CHECK(load_with_time(2026, 11, 16, 18, 0, 0) == 0, "monday 18:00 is already over");
+}
+
+static void test_weekend_ignored(void)
+{
+    /* 2026-11-14 is a Saturday, 2026-11-15 a Sunday. */
+    CHECK(load_with_time(2026, 11, 14, 10, 0, 0) == 0, "saturday 10:00 stays on the plain default");
+    CHECK(load_with_time(2026, 11, 15, 10, 0, 0) == 0, "sunday 10:00 stays on the plain default");
+}
+
+static void test_friday_evening_over(void)
+{
+    CHECK(load_with_time(2026, 11, 20, 18, 0, 0) == 0, "friday 18:00 is over");
+}
+
+static void test_offset_moves_the_window(void)
+{
+    /* 06:30 UTC + 60 = 07:30 local on the same Monday: work. */
+    CHECK(load_with_time(2026, 11, 16, 6, 30, 60) == 1, "positive offset brings the window in");
+    /* 17:30 UTC + 60 = 18:30 local: over. */
+    CHECK(load_with_time(2026, 11, 16, 17, 30, 60) == 0, "positive offset pushes past the end");
+}
+
+static void test_offset_crossing_midnight_moves_the_day(void)
+{
+    /* Sunday 23:30 UTC + 60 = Monday 00:30 local: workday by date, but before
+       07:00, so the plain default. */
+    CHECK(load_with_time(2026, 11, 15, 23, 30, 60) == 0, "monday just after midnight is before the window");
+    /* Friday 23:30 UTC + 60 = Saturday 00:30: weekend, so the plain default;
+       either way it is outside the window, so this pins the weekday shift. */
+    CHECK(load_with_time(2026, 11, 20, 23, 30, 60) == 0, "saturday just after midnight is the weekend");
+}
+
+static void test_malformed_lines_ignored(void)
+{
+    config_text =
+        "default nixos\n"
+        "schedule nixos-work someday 07:00-18:00\n"
+        "schedule nixos-work mon-fri 18:00-07:00\n"
+        "schedule nixos-work mon-fri 7:00-18:00\n"
+        "volume work partuuid=4a512320-ad94-44b6-883f-ba9c8a3335c2\n"
+        "entry NixOS | \\EFI\\systemd\\systemd-bootx64.efi | logos/nixos.png | backgrounds/nixos.jpg | nixos\n"
+        "entry NixOS (work) | @work:\\EFI\\systemd\\systemd-bootx64.efi | logos/nixos.png | backgrounds/nixos.jpg | nixos-work\n";
+    mock_set_time(2026, 11, 16, 10, 0, 0);
+
+    {
+        Config config;
+        EntryList entries;
+
+        mem_set(&entries, 0, sizeof(entries));
+        config_load(&config, &entries);
+        CHECK(config.default_index == 0, "bad schedule lines do not change the default");
+    }
+}
+
+static void test_later_rule_wins(void)
+{
+    config_text =
+        "default nixos\n"
+        "schedule nixos-work mon-fri 07:00-18:00\n"
+        "schedule nixos mon-fri 12:00-13:00\n"
+        "volume work partuuid=4a512320-ad94-44b6-883f-ba9c8a3335c2\n"
+        "entry NixOS | \\EFI\\systemd\\systemd-bootx64.efi | logos/nixos.png | backgrounds/nixos.jpg | nixos\n"
+        "entry NixOS (work) | @work:\\EFI\\systemd\\systemd-bootx64.efi | logos/nixos.png | backgrounds/nixos.jpg | nixos-work\n";
+    mock_set_time(2026, 11, 16, 12, 30, 0);
+
+    {
+        Config config;
+        EntryList entries;
+
+        mem_set(&entries, 0, sizeof(entries));
+        config_load(&config, &entries);
+        CHECK(config.default_index == 0, "a later matching rule wins");
+    }
+}
+
+static void test_clock_format_is_24_hour(void)
+{
+    Clock clock;
+    EFI_TIME time;
+
+    mock_set_time(2026, 11, 16, 19, 37, 0);
+    RT->GetTime(&time, NULL);
+
+    clock_init(&clock, 0);
+    clock.updated_at = -10.0f;
+    clock_update(&clock, 0.0f);
