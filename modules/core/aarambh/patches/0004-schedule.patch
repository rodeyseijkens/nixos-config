diff --git a/config/aarambh.conf b/config/aarambh.conf
index c6a09c0..cedf1f3 100644
--- a/config/aarambh.conf
+++ b/config/aarambh.conf
@@ -20,6 +20,15 @@
 # "autodetect yes", loaders found under \EFI\ that no entry uses (Windows,
 # other Linux installs) are added at boot.
 #
+# schedule <entry> <days> <start>-<end>
+#
+#   While the local clock (UEFI time plus utc_offset) is inside the window on
+#   one of the days, that entry becomes the default. Days are three-letter
+#   names or ranges separated by commas ("mon-fri", "sat,sun", "*"); the time
+#   is 24-hour and the end is exclusive. Later matching lines win.
+#
+#   schedule nixos-work mon-fri 07:00-18:00
+#
 # default is an OS key (ubuntu, fedora, windows), a menu title or an index.
 # Change theme, default and timeout from any connected OS with:
 #   aarambh --theme cinema --default fedora --timeout 5
diff --git a/src/core/clock.c b/src/core/clock.c
index 4c88f8c..d07f473 100644
--- a/src/core/clock.c
+++ b/src/core/clock.c
@@ -14,7 +14,7 @@ void clock_init(Clock *clock, int utc_offset_minutes)
     clock->utc_offset_minutes = utc_offset_minutes;
 }
 
-static int local_minutes(const EFI_TIME *time, int offset)
+int clock_local_minutes(const EFI_TIME *time, int offset)
 {
     int minutes = time->Hour * 60 + time->Minute + offset;
 
@@ -56,7 +56,7 @@ void clock_update(Clock *clock, float now)
         return;
     }
 
-    minutes = local_minutes(&time, clock->utc_offset_minutes);
+    minutes = clock_local_minutes(&time, clock->utc_offset_minutes);
     format_time(clock, minutes / 60, minutes % 60);
 }
 
