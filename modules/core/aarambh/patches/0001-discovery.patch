+static int split_volume_target(const EntryVolumes *volumes, char *target,
+                               const char **volume, int capacity)
+{
+    char *colon = target;
+
+    if (target[0] != '@') {
+        return 1;
+    }
+
+    while (*colon != '\0' && *colon != ':' && *colon != '\\' && *colon != '/') {
+        colon++;
+    }
+
+    if (*colon != ':') {
+        return 1;
+    }
+
+    *colon = '\0';
+    {
