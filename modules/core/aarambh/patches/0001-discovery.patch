+
+static const char *WORK_ID = "4a512320-ad94-44b6-883f-ba9c8a3335c2";
+
+/* Everything exists: these tests are about parsing and dedupe, not the ESP. */
+void fs_make_path(CHAR16 *output, int capacity, const char *name)
+{
+    int i = 0;
+
+    while (name[i] != '\0' && i < capacity - 1) {
+        output[i] = (CHAR16)(UINT8)name[i];
+        i++;
+    }
+    output[i] = 0;
+}
+
+int fs_exists(const CHAR16 *path) { return 1; }
+int fs_exists_volume(const char *volume, const CHAR16 *path) { return 1; }
+int fs_volume_exists(int index, const CHAR16 *path) { return 1; }
+void fs_volume_list_directory(int index, const CHAR16 *path, FsDirectoryCallback callback,
+                              void *context) {}
+int fs_volumes_scan(void) { return 0; }
+const char *fs_volume_id(int index) { return ""; }
+int fs_volume_is_own(int index) { return 0; }
+
+void kernels_load(Entry *entry) {}
+int power_firmware_setup_supported(void) { return 1; }
+
+static int wide_equals(const CHAR16 *wide, const char *ascii)
+{
+    int i = 0;
+
+    while (ascii[i] != '\0') {
+        if (wide[i] != (CHAR16)(UINT8)ascii[i]) {
+            return 0;
+        }
+        i++;
+    }
+
+    return wide[i] == 0;
+}
+
+static void add_line(EntryList *list, const EntryVolumes *volumes, const char *text)
+{
+    char line[384];
+
+    strcpy(line, text);
+    entries_add_line_with_volumes(list, line, volumes);
+}
+
+static void check_volume_line(void)
+{
+    EntryVolumes volumes;
+    char value[128];
+
+    memset(&volumes, 0, sizeof(volumes));
+    CHECK(entries_parse_volume(&volumes, "work partuuid=4A512320-AD94-44B6-883F-BA9C8A3335C2")
+          && volumes.count == 1,
+          "a volume line with a partuuid is accepted");
+    CHECK(strcmp(volumes.items[0].name, "work") == 0, "the volume name is kept");
+    CHECK(strcmp(volumes.items[0].id, WORK_ID) == 0, "the volume identity is lowercase");
+
+    strcpy(value, "broken");
+    CHECK(!entries_parse_volume(&volumes, value) && volumes.count == 1,
+          "a volume line without partuuid= adds nothing");
+}
+
+static void check_name_prefix(void)
+{
+    EntryList list;
+    EntryVolumes volumes;
+
+    memset(&list, 0, sizeof(list));
+    memset(&volumes, 0, sizeof(volumes));
+    entries_parse_volume(&volumes, "work partuuid=4a512320-ad94-44b6-883f-ba9c8a3335c2");
+
+    add_line(&list, &volumes,
+             "entry NixOS (work) | @work:\\EFI\\SYSTEMD\\SYSTEMD-BOOTX64.EFI | logos/nixos.png | "
+             "backgrounds/nixos.jpg | nixos-work");
+    CHECK(list.count == 1, "an @name: loader adds one entry");
+    CHECK(list.count == 1 && strcmp(list.items[0].volume, WORK_ID) == 0,
+          "@name: stores the named volume's identity");
+    CHECK(list.count == 1
+          && wide_equals(list.items[0].loader, "\\EFI\\SYSTEMD\\SYSTEMD-BOOTX64.EFI"),
+          "@name: leaves only the loader path");
+
+    add_line(&list, &volumes,
+             "entry Local | \\EFI\\BOOT\\BOOTX64.EFI | logos/nixos.png | backgrounds/nixos.jpg | "
+             "local");
+    CHECK(list.count == 2 && list.items[1].volume[0] == '\0',
+          "an entry without @name: stays on the image's own volume");
+
+    add_line(&list, &volumes,
+             "entry Missing | @unknown:\\EFI\\BOOT\\BOOTX64.EFI | | | missing");
+    CHECK(list.count == 2, "an undeclared volume name adds no entry");
+}
+
+static void check_dedupe(void)
+{
+    EntryList list;
+    EntryVolumes volumes;
+
+    memset(&list, 0, sizeof(list));
+    memset(&volumes, 0, sizeof(volumes));
+    entries_parse_volume(&volumes, "work partuuid=4a512320-ad94-44b6-883f-ba9c8a3335c2");
+    entries_parse_volume(&volumes, "other partuuid=b85a008a-8f4f-45d8-a72e-26b9794d9cd4");
+
+    add_line(&list, &volumes,
+             "entry Work | @work:\\EFI\\SYSTEMD\\SYSTEMD-BOOTX64.EFI | | | work");
+    add_line(&list, &volumes,
+             "entry Other | @other:\\EFI\\SYSTEMD\\SYSTEMD-BOOTX64.EFI | | | other");
+    CHECK(list.count == 2, "the same loader path on two volumes is kept twice");
+
+    add_line(&list, &volumes,
+             "entry Work again | @work:\\efi/systemd/systemd-bootx64.EFI | | | work-again");
+    CHECK(list.count == 2, "the same (volume, path) in another case is deduped");
+}
+
+static void check_autodetect_skip(void)
+{
+    EntryList list;
+    EntryVolumes volumes;
+
+    memset(&list, 0, sizeof(list));
+    memset(&volumes, 0, sizeof(volumes));
+    entries_parse_volume(&volumes, "work partuuid=4a512320-ad94-44b6-883f-ba9c8a3335c2");
+
+    CHECK(autodetect_should_skip(&list, "", 1, "systemd",
+                                 "\\EFI\\SYSTEMD\\SYSTEMD-BOOTX64.EFI"),
+          "the own volume's systemd-boot is hidden, whatever the case");
+    CHECK(!autodetect_should_skip(&list, "4a512320-ad94-44b6-883f-ba9c8a3335c2", 0, "systemd",
+                                  "\\EFI\\SYSTEMD\\SYSTEMD-BOOTX64.EFI"),
+          "another volume's systemd-boot is still autodetected");
+    CHECK(!autodetect_should_skip(&list, "", 1, "refind", "\\EFI\\refind\\refind_x64.efi"),
+          "the hide rule only covers systemd-boot");
+
+    add_line(&list, &volumes,
+             "entry Windows | @work:\\EFI\\MICROSOFT\\BOOT\\BOOTMGFW.EFI | | | windows");
+    CHECK(autodetect_should_skip(&list, "4a512320-ad94-44b6-883f-ba9c8a3335c2", 0, "microsoft",
+                                 "\\EFI\\MICROSOFT\\Boot\\bootmgfw.efi"),
+          "an explicit entry covers the same loader path in another case");
+    CHECK(!autodetect_should_skip(&list, "4a512320-ad94-44b6-883f-ba9c8a3335c2", 0, "ubuntu",
+                                  "\\EFI\\ubuntu\\shimx64.efi"),
+          "an uncovered loader is still autodetected");
+}
+
+int main(void)
+{
+    mock_efi_init();
+
+    check_volume_line();
+    check_name_prefix();
+    check_dedupe();
+    check_autodetect_skip();
+
+    return test_result();
+}
