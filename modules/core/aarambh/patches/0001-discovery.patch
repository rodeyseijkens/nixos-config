+
+static void put_hex(char *output, int *position, UINT8 value)
+{
+    static const char digits[] = "0123456789abcdef";
+
+    output[*position] = digits[(value >> 4) & 0x0f];
+    output[*position + 1] = digits[value & 0x0f];
+    *position += 2;
+}
+
+static void put_byte(char *output, int *position, UINT8 value)
+{
+    output[*position] = (char)value;
+    *position += 1;
+}
+
+/* GPT partition GUID, so a config partuuid= line can find this volume. */
+static void format_partuuid(const UINT8 *signature, char *output, int capacity)
+{
+    int position = 0;
+    int i;
+
+    if (capacity < 37) {
+        output[0] = '\0';
+        return;
+    }
+
+    put_hex(output, &position, signature[3]);
+    put_hex(output, &position, signature[2]);
+    put_hex(output, &position, signature[1]);
+    put_hex(output, &position, signature[0]);
+    put_byte(output, &position, '-');
+    put_hex(output, &position, signature[5]);
+    put_hex(output, &position, signature[4]);
+    put_byte(output, &position, '-');
+    put_hex(output, &position, signature[7]);
+    put_hex(output, &position, signature[6]);
+    put_byte(output, &position, '-');
+    put_hex(output, &position, signature[8]);
+    put_hex(output, &position, signature[9]);
+    put_byte(output, &position, '-');
+    for (i = 10; i < 16; i++) {
+        put_hex(output, &position, signature[i]);
+    }
+
+    output[position] = '\0';
+}
+
+/* Without an HD node, the device path text still identifies the volume. */
+static void format_device_path(const EFI_DEVICE_PATH *device_path, char *output, int capacity)
+{
+    CHAR16 *text;
+    int position = 0;
+
+    output[0] = '\0';
+    if (device_path == NULL) {
+        return;
+    }
+
+    text = DevicePathToStr((EFI_DEVICE_PATH *)device_path);
+    if (text != NULL) {
+        while (text[position] != 0 && position < capacity - 1) {
+            output[position] = text[position] < 128 ? (char)text[position] : '_';
+            position++;
+        }
+        output[position] = '\0';
+        FreePool(text);
+
+        if (position > 0) {
+            return;
+        }
+    }
+
+    position = 0;
+    {
+        const EFI_DEVICE_PATH *node;
+
+        for (node = device_path; position < capacity - 3; node = NextDevicePathNode(node)) {
+            int i;
+
+            for (i = 0; i < DevicePathNodeLength(node) && position < capacity - 3; i++) {
+                put_hex(output, &position, ((const UINT8 *)node)[i]);
+            }
+
+            if (IsDevicePathEnd(node)) {
+                break;
+            }
+        }
+    }
+
+    output[position] = '\0';
+}
+
+static void volume_identity(EFI_HANDLE handle, char *output, int capacity)
+{
+    EFI_DEVICE_PATH *device_path = NULL;
+    const EFI_DEVICE_PATH *node;
+
+    output[0] = '\0';
+    if (handle == NULL || BS == NULL || BS->HandleProtocol == NULL) {
+        return;
+    }
+
+    if (BS->HandleProtocol(handle, &device_path_guid, (void **)&device_path) != EFI_SUCCESS
+        || device_path == NULL) {
+        return;
+    }
+
+    for (node = device_path; !IsDevicePathEnd(node); node = NextDevicePathNode(node)) {
+        if (DevicePathType(node) == MEDIA_DEVICE_PATH
+            && DevicePathSubType(node) == MEDIA_HARDDRIVE_DP) {
+            const HARDDRIVE_DEVICE_PATH *hard_drive = (const HARDDRIVE_DEVICE_PATH *)node;
+
+            if (hard_drive->SignatureType == SIGNATURE_TYPE_GUID) {
+                format_partuuid(hard_drive->Signature, output, capacity);
+                return;
+            }
+        }
+    }
+
+    format_device_path(device_path, output, capacity);
+}
+
+int fs_volumes_scan(void)
+{
+    EFI_GUID protocol = EFI_SIMPLE_FILE_SYSTEM_PROTOCOL_GUID;
+    EFI_HANDLE *handles = NULL;
+    UINTN count = 0;
+    UINTN i;
+
+    if (volume_count >= 0) {
+        return volume_count;
+    }
+
+    volume_count = 0;
+    if (BS == NULL || BS->LocateHandleBuffer == NULL) {
+        return 0;
+    }
+
+    if (BS->LocateHandleBuffer(ByProtocol, &protocol, NULL, &count, &handles) != EFI_SUCCESS) {
+        return 0;
+    }
+
+    for (i = 0; i < count && volume_count < FS_MAX_VOLUMES; i++) {
+        FsVolume *volume = &volumes[volume_count];
+        EFI_FILE_HANDLE base = LibOpenRoot(handles[i]);
+
+        if (base == NULL) {
+            continue;
+        }
+
+        volume->handle = handles[i];
+        volume->root = base;
+        volume->own = handles[i] == own_handle;
+        volume_identity(handles[i], volume->id, sizeof(volume->id));
+
+        if (!volume->own && own_id[0] != '\0' && str_equal(volume->id, own_id)) {
+            volume->own = 1;
+        }
+
+        if (volume->own) {
+            str_copy(own_id, volume->id, sizeof(own_id));
+        }
+
+        volume_count++;
+    }
+
+    FreePool(handles);
+    return volume_count;
+}
+
+int fs_volume_count(void)
+{
+    return fs_volumes_scan();
+}
+
+const char *fs_volume_id(int index)
+{
+    if (index < 0 || index >= fs_volumes_scan()) {
+        return "";
+    }
+
+    return volumes[index].id;
+}
+
+int fs_volume_is_own(int index)
+{
+    if (index < 0 || index >= fs_volumes_scan()) {
+        return 0;
+    }
+
+    return volumes[index].own;
+}
+
+void fs_volume_list_directory(int index, const CHAR16 *path, FsDirectoryCallback callback,
+                              void *context)
+{
+    if (index < 0 || index >= fs_volumes_scan()) {
+        return;
+    }
+
+    list_directory_from(volumes[index].root, path, callback, context);
+}
+
+int fs_volume_exists(int index, const CHAR16 *path)
+{
+    EFI_FILE_HANDLE file;
+
+    if (index < 0 || index >= fs_volumes_scan()) {
+        return 0;
+    }
+
+    if (volumes[index].root->Open(volumes[index].root, &file, (CHAR16 *)path,
+                                  EFI_FILE_MODE_READ, 0) != EFI_SUCCESS) {
+        return 0;
+    }
+
+    file->Close(file);
+    return 1;
+}
+
+static int same_nocase(const char *left, const char *right)
+{
+    return str_length(left) == str_length(right) && str_starts_with_nocase(left, right);
+}
+
+static int find_volume(const char *volume)
+{
+    int count = fs_volumes_scan();
+    int i;
+
+    for (i = 0; i < count; i++) {
+        if (same_nocase(volumes[i].id, volume)) {
+            return i;
+        }
+    }
+
+    return -1;
+}
+
+EFI_HANDLE fs_volume_handle(const char *volume)
+{
+    int index;
+
+    if (str_is_empty(volume)) {
+        return own_handle;
+    }
+
+    index = find_volume(volume);
+    return index < 0 ? NULL : volumes[index].handle;
+}
+
+int fs_exists_volume(const char *volume, const CHAR16 *path)
+{
+    EFI_FILE_HANDLE file;
+    int index;
+
+    if (str_is_empty(volume)) {
+        if (root->Open(root, &file, (CHAR16 *)path, EFI_FILE_MODE_READ, 0) != EFI_SUCCESS) {
+            return 0;
+        }
+
+        file->Close(file);
+        return 1;
+    }
+
+    index = find_volume(volume);
+    return fs_volume_exists(index, path);
+}
+
+void *fs_read_volume(const char *volume, const CHAR16 *path, UINTN *size)
+{
+    int index = find_volume(volume);
+    UINTN file_size = 0;
+    EFI_FILE_HANDLE file;
+
+    if (str_is_empty(volume)) {
+        file = open_path(path, &file_size);
+        return read_whole(file, file_size, size);
+    }
+
+    if (index < 0) {
+        return NULL;
+    }
+
+    file = open_path_on(volumes[index].root, path, &file_size);
+    return read_whole(file, file_size, size);
 }
