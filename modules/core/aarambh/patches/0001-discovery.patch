diff --git a/config/aarambh.conf b/config/aarambh.conf
index ba54bd6..c6a09c0 100644
--- a/config/aarambh.conf
+++ b/config/aarambh.conf
@@ -8,6 +8,14 @@
 #   key         OS id (/etc/os-release ID), used for <key>.kernels
 #   accent      Optional color, e.g. #e95420
 #
+# volume <name> partuuid=<guid>
+#
+#   Declares another ESP by its GPT partition UUID. Write that volume's loader
+#   as @<name>:\EFI\... ; loaders without the prefix stay on this ESP.
+#
+#   volume work partuuid=4a512320-ad94-44b6-883f-ba9c8a3335c2
+#   entry NixOS (work) | @work:\EFI\SYSTEMD\SYSTEMD-BOOTX64.EFI | logos/nixos.png | backgrounds/nixos.jpg | nixos-work
+#
 # Linux entries are added by hooks/setup.sh on each installation. With
 # "autodetect yes", loaders found under \EFI\ that no entry uses (Windows,
 # other Linux installs) are added at boot.
