{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.aarambh;
  colors = config.lib.stylix.colors;

  # Scales a "RRGGBB" hex string by a percentage, per channel, for shades of
  # the paper. TOML integer literals accept 0x, which is the easiest hex parse
  # in Nix.
  channelHex = hex:
    (builtins.fromTOML "v = 0x${lib.toLower hex}").v;

  scaleHex = hex: percent: let
    part = a: b:
      lib.fixedWidthString 2 "0"
      (lib.toHexString ((channelHex (builtins.substring a 2 hex)) * percent / 100));
  in
    part 0 2 + part 2 4 + part 4 6;

  aarambh = pkgs.callPackage ./aarambh/package.nix {
    palette = {
      # The boot menu palette: paper base01, ink base06, accent base0D.
      paper = colors.base01;
      ink = colors.base06;
      accent = colors.base0D;
      paperDark = scaleHex colors.base01 65;
    };
  };

  entryType = lib.types.submodule {
    options = {
      title = lib.mkOption {
        type = lib.types.str;
        description = "Name shown in the menu.";
      };
      loader = lib.mkOption {
        type = lib.types.str;
        description = ''
          UEFI path of the loader. Prefix it with @name: to load it from the
          volume declared in aarambh.volumes, e.g. @work:\EFI\SYSTEMD\SYSTEMD-BOOTX64.EFI.
        '';
      };
      logo = lib.mkOption {
        type = lib.types.str;
        description = "Logo, relative to the menu directory.";
      };
      background = lib.mkOption {
        type = lib.types.str;
        description = "Background, relative to the menu directory.";
      };
      key = lib.mkOption {
        type = lib.types.str;
        default = "";
        description = "OS key used for the default setting and the kernel list.";
      };
    };
  };

  # Built-in entries that every menu has, after the OS entries.
  powerEntries = [
    {
      title = "Firmware";
      loader = "@firmware";
      logo = "logos/settings.png";
      background = "backgrounds/settings.jpg";
      key = "";
    }
    {
      title = "Restart";
      loader = "@reboot";
      logo = "logos/restart.png";
      background = "backgrounds/restart.jpg";
      key = "";
    }
    {
      title = "Power Off";
      loader = "@shutdown";
      logo = "logos/power.png";
      background = "backgrounds/power.jpg";
      key = "";
    }
  ];

  # This machine's own NixOS: the kernel list comes from its BLS entries, and
  # the loader is the systemd-boot on the same ESP.
  ownEntry = {
    title = "NixOS";
    loader = ''\EFI\systemd\systemd-bootx64.efi'';
    logo = "logos/nixos.png";
    background = "backgrounds/nixos.jpg";
    key = "nixos";
  };

  entryLine = e: "entry ${e.title} | ${e.loader} | ${e.logo} | ${e.background} | ${e.key}";

  menuConf = pkgs.writeText "aarambh.conf" ''
    # Generated by modules/core/aarambh.nix. Edit the NixOS config instead.
    theme editorial-gruvbox
    timeout ${toString cfg.timeout}
    default ${cfg.default}
    autodetect yes
    edit yes

    font_light fonts/light.ttf
    font_regular fonts/regular.ttf
    font_bold fonts/bold.ttf
    font_mono fonts/mono.ttf

    ${lib.concatStringsSep "\n" (lib.mapAttrsToList (name: partuuid: "volume ${name} partuuid=${partuuid}") cfg.volumes)}

    ${lib.concatMapStringsSep "\n" entryLine ([ownEntry] ++ cfg.entries ++ powerEntries)}
  '';

  espScript = pkgs.writeShellApplication {
    name = "aarambh-esp";
    runtimeInputs = with pkgs; [
      coreutils
      efibootmgr
      findutils
      gawk
      gnused
      gnugrep
      util-linux
    ];
    text =
      builtins.replaceStrings
      ["@share@" "@conf@" "@partuuid@"]
      [
        "${aarambh}/share/aarambh"
        "${menuConf}"
        (lib.optionalString (cfg.espPartuuid != null) cfg.espPartuuid)
      ]
      (builtins.readFile ./aarambh/aarambh-esp.sh);
  };

  # Manual cleanup. Without the marker on the ESP, it changes nothing.
  uninstallScript = pkgs.writeShellScriptBin "aarambh-uninstall" ''
    exec ${espScript}/bin/aarambh-esp remove "$@"
  '';
in {
  options.aarambh = {
    enable = lib.mkEnableOption "the Aarambh boot menu on the ESP at /boot";

    espPartuuid = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "b85a008a-8f4f-45d8-a72e-26b9794d9cd4";
      description = ''
        GPT PARTUUID of the ESP that holds the menu. Required when the module
        is enabled, and checked before anything is written.
      '';
    };

    default = lib.mkOption {
      type = lib.types.str;
      default = "nixos";
      description = "OS key or menu title of the entry that starts by default.";
    };

    timeout = lib.mkOption {
      type = lib.types.ints.unsigned;
      default = 5;
      description = "Seconds before the default entry starts.";
    };

    volumes = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {};
      example = {work = "4a512320-ad94-44b6-883f-ba9c8a3335c2";};
      description = "Other ESPs by name and PARTUUID, used by @name: loaders.";
    };

    entries = lib.mkOption {
      type = lib.types.listOf entryType;
      default = [];
      description = "Extra menu entries, shown after this machine's NixOS.";
    };
  };

  config = lib.mkMerge [
    {
      # The helper and efibootmgr are available on every host. The helper
      # changes nothing without the marker file.
      environment.systemPackages = [
        pkgs.efibootmgr
        uninstallScript
      ];

      # Runs after systemd-boot has written its entries and kernels. Hosts
      # without an ESP PARTUUID (desktop-work) get no hook.
      boot.loader.systemd-boot.extraInstallCommands = lib.mkIf (cfg.espPartuuid != null) ''
        ${espScript}/bin/aarambh-esp ${
          if cfg.enable
          then "install"
          else "remove"
        }
      '';
    }

    (lib.mkIf cfg.enable {
      boot.plymouth = {
        enable = lib.mkDefault true;
        theme = lib.mkDefault "aarambh";
        themePackages = lib.mkDefault [aarambh];
      };

      assertions = [
        {
          assertion = cfg.espPartuuid != null;
          message = "aarambh.enable needs aarambh.espPartuuid";
        }
        {
          assertion = config.boot.loader.systemd-boot.enable;
          message = "aarambh needs boot.loader.systemd-boot.enable, which keeps the fallback loader";
        }
      ];
    })
  ];
}
